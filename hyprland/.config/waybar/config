{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["network", "pulseaudio", "cpu", "memory", "clock", "tray"],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60
  },
  "network": {
    "format-wifi": "{essid}  {signalStrength}%",
    "format-ethernet": "{ifname}",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "Muted",
    "format-icons": {
      "default": ["", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "cpu": {
    "format": "{usage}%"
  },
  "memory": {
    "format": "{}%"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "{:%A, %d de %B de %Y}"
  },
  "tray": {
    "icon-size": 17,
    "spacing": 4
  }
}