// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "minimap": {
    "show": "always"
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": false,
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  // Blame (equivalente à parte útil do GitLens)
  "git_blame": {
    "show_commit_summary": true,
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pdftotext\\b",
            },
            {
              "pattern": "^grep\\s+Produto:(\\s|$)",
            },
            {
              "pattern": "^sort\\b",
            },
            {
              "pattern": "^uniq\\b",
            },
          ],
        },
      },
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "text_rendering_mode": "grayscale",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Cascadia Code",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Material Icon Theme",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 12.0,
    "font_family": "CaskaydiaCove NF",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  // --- IA ---
  "features": {
    "copilot": true,
  },
  // Extensions que o Zed instala sozinho no próximo boot
  "auto_install_extensions": {
    "wakatime": true,
    "context7": true,
  },
  // --- Performance (equivale aos watcherExclude/search.exclude do VSCode) ---
  "file_scan_exclusions": [
    "**/node_modules",
    "**/dist",
    "**/target",
  ],
  // --- File nesting (equivalente ao explorer.fileNesting do VSCode) ---
  "file_nesting": {
    "hide_files": false,
    "patterns": {
      "*.js": ["*.cjs", "*.mjs", "*.d.ts", "*.test.js", "*.spec.js"],
      "*.ts": ["*.d.ts", "*.test.ts", "*.spec.ts"],
      "*.jsx": ["*.test.jsx", "*.spec.jsx"],
      "*.tsx": ["*.test.tsx", "*.spec.tsx"],
      "*.css": ["*.css.map"],
      "package.json": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock"],
    },
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "base_keymap": "VSCode",
  "tabs": {
    "activate_on_close": "left_neighbour",
  },
  "tab_bar": {
    "show": true
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },
  "buffer_font_fallbacks": [
    "monospace"
  ],
  "semantic_tokens": "combined",
  // Error Lens style: diagnostic inline na linha
  "inline_diagnostics": {
    "cursorline": "enabled",
    "other_lines": "enabled",
  },
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark Colorblind",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "github-copilot-chat": {
      "type": "registry",
    },
    "OpenCode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode/deepseek-v4-flash-free",
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSX": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Lua": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
  },
}
