// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": false,
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pdftotext\\b",
            },
            {
              "pattern": "^grep\\s+Produto:(\\s|$)",
            },
            {
              "pattern": "^sort\\b",
            },
            {
              "pattern": "^uniq\\b",
            },
          ],
        },
      },
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "text_rendering_mode": "grayscale",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Cascadia Code",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 13.0,
    "font_family": "CaskaydiaCove Nerd Font",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "base_keymap": "VSCode",
  "tabs": {
    "activate_on_close": "left_neighbour",
  },
  "tab_bar": {
    "show": true
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },
  "buffer_font_fallbacks": ["CaskaydiaCove Nerd Font Mono"],
  "semantic_tokens": "combined",
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark Colorblind",
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode/deepseek-v4-flash-free",
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSX": {
      "formatter": {
        "language_server": {
          "name": "biome",
        },
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
  },
}
