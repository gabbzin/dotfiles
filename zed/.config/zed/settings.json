// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pdftotext\\b"
            },
            {
              "pattern": "^grep\\s+Produto:(\\s|$)"
            },
            {
              "pattern": "^sort\\b"
            },
            {
              "pattern": "^uniq\\b"
            }
          ]
        }
      }
    },
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "text_rendering_mode": "grayscale",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Cascadia Code",
  "icon_theme": "Catppuccin Latte",
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "terminal": {
    "font_family": "CaskaydiaCove NF"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },

  "tabs": {
    "activate_on_close": "left_neighbour"
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "buffer_font_fallbacks": ["monospace"],
  "semantic_tokens": "combined",
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "GitHub Dark Colorblind"
  },

  "agent_servers": {
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  }
}
