{
  "files.autoSave": "afterDelay",
  "[c]": {
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.insertMode": "replace",
    "editor.semanticHighlighting.enabled": true,
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${basename}.test.ts, ${basename}.spec.ts, ${basename}.d.ts, ${basename}.map",
    "*.js": "${basename}.test.js, ${basename}.spec.js, ${basename}.d.ts, ${basename}.map",
    "*.tsx": "${basename}.test.tsx, ${basename}.spec.tsx",
    "*.jsx": "${basename}.test.jsx, ${basename}.spec.jsx",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    ".eslintrc": ".eslintrc.js, .eslintrc.json, .eslintrc.yaml",
    "tsconfig.json": "tsconfig.build.json, tsconfig.*.json",
  },
  "editor.wordWrap": "on",
  "animations.Install-Method": "Apc Customize UI++",
  "workbench.iconTheme": "material-icon-theme",
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "jdk.jdkhome": "c:\\Program Files\\Java\\jdk-21",
  "git.enableSmartCommit": true,
  "code-runner.runInTerminal": true,
  "explorer.compactFolders": false,
  "code-runner.ignoreSelection": true,
  "code-runner.executorMap": {
    "java": "cls ; cd $dir && javac $fileName && java $fileNameWithoutExt && del $fileNameWithoutExt.class",
    "python": "cls ; python -u",
    "csharp": "cls ; dotnet run",
  },
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask",
  ],
  "editor.formatOnSave": true,
  // "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "gitlens.ai.experimental.model": "openai:gpt-4o",
  "glassit.alpha": 255,
  "workbench.colorTheme": "GitHub Dark Default",
  "liveServer.settings.donotVerifyTags": true,
  "editor.guides.bracketPairs": true,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [100],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.tabSize": 2,
  },
  "workbench.editor.empty.hint": "hidden",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "files.associations": {
    "*.css": "css",
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
  },
  "terminal.external.linuxExec": "kitty",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\cgabr\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "jdk.telemetry.enabled": false,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromCodeNavigation": false,
  // Configurações da barra de atividade
  "workbench.activityBar.location": "top",
  "workbench.activityBar.iconClickBehavior": "toggle",
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "gitlens.ai.model": "gemini:gemini-2.5-flash",
  "github.copilot.nextEditSuggestions.enabled": true,
  "editor.tabSize": 2,
  "terminal.integrated.fontFamily": "CaskaydiaCove NF",
  "editor.fontLigatures": true,
  "files.autoSaveDelay": 500,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "material-icon-theme.folders.theme": "specific",
  "workbench.editor.focusRecentEditorAfterClose": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "chat.mcp.gallery.enabled": true,
  "frosted-glass-theme.fakeMica.enabled": true,
  "editor.fontFamily": "'Cascadia Code', 'monospace', monospace",
  "gitlens.launchpad.indicator.enabled": false,
  "search.followSymlinks": false,
  "git.autofetch": true,
  "editor.language.brackets": [],
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
  },
  "dart.flutterSdkPath": "/home/gab/flutter",
  "redhat.telemetry.enabled": true,
  "material-icon-theme.activeIconPack": "nest",
  "python.defaultInterpreterPath": "/bin/python",
  "editor.aiStats.enabled": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true,
    "https://ui.shadcn.com": true,
  },
  "chat.viewSessions.orientation": "stacked",
  "dotfiles.targetPath": "",
  "editor.fontSize": 13,
  "terminal.integrated.fontSize": 12,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "biome.suggestInstallingGlobally": false,
}
